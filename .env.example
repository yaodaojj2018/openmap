# ============================================================
# OpenMap 环境配置模板 —— 复制为 .env 后按需填写
# 密钥永不提交仓库（.gitignore 已排除 .env）
# ============================================================

# ---- 后端：百度地图 Web 服务 API（服务端 AK，仅存后端）----
# 控制台 https://lbsyun.baidu.com/apiconsole/key 创建，类型选"服务端"
OPENMAP_BAIDU_AK=
# 可选：校验方式选 SN 校验时填写
OPENMAP_BAIDU_SK=

# ---- 演示模式：1 = 快照回放，零 API 配额消耗（评审默认）----
# 配置了 OPENMAP_BAIDU_AK 后置 0 走真实 API
OPENMAP_DEMO_MODE=1

# ---- 限流与重试（按账号配额调整，默认保守值）----
OPENMAP_API_QPS=5
OPENMAP_RETRY_MAX_ATTEMPTS=3

# ---- 缓存：留空 = 进程内缓存；本地/容器 compose 内置 redis 时可用下面这行 ----
# OPENMAP_REDIS_URL=redis://localhost:6379/0

# ---- 前端：百度地图 JS API AK（浏览器端，需配置域名白名单 localhost）----
# 注意：与上面服务端 AK 是两个不同的 Key；留空时地图不可用但数据面板仍可演示
VITE_BMAP_AK=
